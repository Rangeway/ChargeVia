---
import BaseLayout from "../layouts/BaseLayout.astro";

const basics = [
  {
    title: "Reliable equipment.",
    body: "Specified well. Watched closely. Maintained properly."
  },
  {
    title: "Front-and-center placement.",
    body: "Easy to find. Easy to enter."
  },
  {
    title: "Covered and well lit.",
    body: "A proper stop, day or night."
  },
  {
    title: "Easy to start.",
    body: "Clear directions. Straightforward payment."
  },
  {
    title: "A useful host next door.",
    body: "Food, restrooms, retail. The useful stuff."
  }
];

const driverSteps = [
  {
    number: "01",
    title: "Spot it.",
    body: "Visible placement. Clear way in."
  },
  {
    number: "02",
    title: "Plug in.",
    body: "Reliable charging. No instruction manual."
  },
  {
    number: "03",
    title: "Do something useful.",
    body: "Food. Restroom. Retail. Your call."
  },
  {
    number: "04",
    title: "Get moving.",
    body: "Back on the road. That was the idea."
  }
];

const chargeViaScope = [
  "Site planning and development",
  "Design and construction",
  "Equipment and procurement",
  "Project financing",
  "Operations and maintenance",
  "Brand and customer support"
];

const hostScope = [
  "A well-located site",
  "Existing amenities",
  "Site and utility information",
  "Local operating knowledge",
  "A reason for drivers to stay a while",
  "A better use for the property"
];

const hostSteps = [
  {
    number: "01",
    title: "Show us the site.",
    body: "Where it is. What is there. Why it works."
  },
  {
    number: "02",
    title: "We do the homework.",
    body: "Location. Power. Layout. Economics."
  },
  {
    number: "03",
    title: "Build the right fit.",
    body: "Designed for the property. Never dropped in."
  },
  {
    number: "04",
    title: "Keep it working.",
    body: "Rangeway runs it. Maintenance included."
  }
];

const faqs = [
  {
    question: "Is ChargeVia a standalone company?",
    answer:
      "No. ChargeVia is a Rangeway product. Rangeway develops and operates it."
  },
  {
    question: "What does a ChargeVia-built site include?",
    answer:
      "Reliable fast charging, visible placement, coverage, lighting, clear directions, and active maintenance. Hosts provide the amenities."
  },
  {
    question: "What kinds of hosts are a fit?",
    answer:
      "Retailers, QSRs, convenience stores, and properties that give drivers a useful reason to stop."
  },
  {
    question: "Does the host have to operate the chargers?",
    answer:
      "No. Rangeway handles the charging product and ongoing operations."
  },
  {
    question: "Have a site in mind?",
    answer: "Send the address and a short property description to",
    email: "hello@chargevia.net"
  }
];

const hostMailto =
  "mailto:hello@chargevia.net?subject=Bring%20ChargeVia%20to%20my%20site";
---

<BaseLayout>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <div class="hero__copy-inner">
          <p class="eyebrow eyebrow--on-dark">
            <span class="double-chevron" aria-hidden="true">»</span>
            ChargeVia by Rangeway
          </p>
          <h1 id="hero-title" class="hero__title">
            The stop that<br />
            always works<span aria-hidden="true">.</span>
          </h1>
          <p class="hero__lede">
            Fast charging without the scavenger hunt. Covered. Clean. Lit. Ready.
          </p>
          <div class="hero__actions">
            <a class="button button--orange" href="#drivers">
              See the stop <span aria-hidden="true">»</span>
            </a>
            <a class="text-link text-link--light" href="#hosts">
              For site hosts <span aria-hidden="true">↘</span>
            </a>
          </div>
        </div>
      </div>

      <figure class="hero__figure">
        <img
          src="/images/cv-hero-night.jpg"
          alt="Concept rendering of a ChargeVia charging stop illuminated at night"
          width="2000"
          height="1116"
          fetchpriority="high"
        />
        <figcaption class="concept-label">Concept rendering</figcaption>
      </figure>

      <div class="route-line" aria-hidden="true"></div>
    </section>

    <section id="drivers" class="driver-intro section-dark" aria-labelledby="driver-title">
      <div class="page-grid">
        <div class="driver-intro__lead">
          <p class="eyebrow eyebrow--on-dark">For drivers</p>
          <h2 id="driver-title">Pull in.<br />Plug in.<br />Breathe out<span>.</span></h2>
        </div>
        <div class="driver-intro__copy">
          <p class="statement">
            Your charging stop should not require a backup plan.
          </p>
          <p>
            ChargeVia pairs a purpose-built charging environment with the food, restrooms, and
            retail already provided by the host. A normal stop. Imagine that.
          </p>
        </div>
      </div>
    </section>

    <section class="placement" aria-labelledby="placement-title">
      <div class="placement__grid page-grid">
        <div class="placement__marker" aria-hidden="true">
          <span>Not here</span>
          <strong>×</strong>
        </div>
        <div class="placement__copy">
          <p class="eyebrow">The parking-lot problem</p>
          <h2 id="placement-title">Charging belongs<br />where people<br />actually stop<span>.</span></h2>
          <p class="statement statement--ink">
            Not behind a big-box retailer. Not at the dark end of a strip mall.
          </p>
          <p>
            Visible. Covered. Lit. Reliable. With something useful nearby.
          </p>
        </div>
      </div>
    </section>

    <section class="basics" aria-labelledby="basics-title">
      <div class="page-grid basics__grid">
        <header class="basics__header">
          <p class="eyebrow">Every stop starts here</p>
          <h2 id="basics-title">The basics.<br />Done right<span>.</span></h2>
          <p class="basics__aside">
            A working charger.<br />
            Imagine that.
          </p>
        </header>

        <ol class="basics__list">
          {basics.map((item, index) => (
            <li class="basic">
              <span class="basic__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <span class="basic__chevron" aria-hidden="true">»</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="driver-journey" aria-labelledby="journey-title">
      <div class="page-grid driver-journey__heading">
        <p class="eyebrow eyebrow--on-dark">A perfectly normal charging stop</p>
        <h2 id="journey-title">In. On. Done<span>.</span></h2>
      </div>
      <ol class="driver-journey__steps">
        {driverSteps.map((step) => (
          <li class="driver-step">
            <span class="driver-step__number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="gallery" aria-labelledby="gallery-title">
      <div class="gallery__heading page-grid">
        <p class="eyebrow eyebrow--on-dark">Built to feel obvious</p>
        <h2 id="gallery-title">Easy to spot.<br />Good to stop<span>.</span></h2>
      </div>
      <div class="gallery__images">
        <figure class="gallery__figure gallery__figure--day">
          <img
            src="/images/cv-station-day.jpg"
            alt="Concept rendering of a ChargeVia canopy and charging stop in daylight"
            width="1760"
            height="982"
            loading="lazy"
          />
          <figcaption class="concept-label">Concept rendering</figcaption>
        </figure>
        <figure class="gallery__figure gallery__figure--night">
          <img
            src="/images/cv-urban-night.jpg"
            alt="Concept rendering of a ChargeVia charging stop in an urban setting at night"
            width="1760"
            height="982"
            loading="lazy"
          />
          <figcaption class="concept-label">Concept rendering</figcaption>
        </figure>
      </div>
    </section>

    <section id="hosts" class="hosts" aria-labelledby="hosts-title">
      <div class="hosts__number" aria-hidden="true">02</div>
      <div class="page-grid hosts__grid">
        <header>
          <p class="eyebrow eyebrow--on-purple">For site hosts</p>
          <h2 id="hosts-title">You bring<br />the place.<br />We build<br />the stop<span>.</span></h2>
        </header>
        <div class="hosts__copy">
          <p class="statement">
            Charging should support the host business, not become another machine to babysit.
          </p>
          <p>
            Rangeway handles development, financing, construction, operations, and maintenance.
            The host keeps doing what it does best.
          </p>
          <a class="button button--dark" href={hostMailto}>
            Start a conversation <span aria-hidden="true">»</span>
          </a>
          <a class="hosts__email" href="mailto:hello@chargevia.net">
            hello@chargevia.net
          </a>
        </div>
      </div>
    </section>

    <section class="host-model" aria-labelledby="host-model-title">
      <div class="page-grid host-model__intro">
        <p class="eyebrow">One site. Two jobs.</p>
        <div>
          <h2 id="host-model-title">A clean division<br />of labor<span>.</span></h2>
          <p>
            ChargeVia runs the charging. The host makes it a place. Everybody stays in their lane.
          </p>
        </div>
      </div>
      <div class="host-model__columns page-grid">
        <section class="scope scope--chargevia" aria-labelledby="chargevia-scope-title">
          <p class="scope__label">ChargeVia / Rangeway</p>
          <h3 id="chargevia-scope-title">We handle the charging<span>.</span></h3>
          <ul>
            {chargeViaScope.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="scope scope--host" aria-labelledby="host-scope-title">
          <p class="scope__label">The site host</p>
          <h3 id="host-scope-title">You make it a place<span>.</span></h3>
          <ul>
            {hostScope.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
    </section>

    <section class="host-process" aria-labelledby="host-process-title">
      <div class="page-grid host-process__heading">
        <p class="eyebrow eyebrow--on-dark">How hosting works</p>
        <h2 id="host-process-title">From good site<br />to good stop<span>.</span></h2>
      </div>
      <ol class="host-process__steps page-grid">
        {hostSteps.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="rangeway" class="relationship" aria-labelledby="relationship-title">
      <div class="page-grid relationship__grid">
        <div>
          <p class="eyebrow">
            <span class="double-chevron" aria-hidden="true">»</span>
            Built by Rangeway
          </p>
          <h2 id="relationship-title">Hospitality thinking.<br />Roadside discipline<span>.</span></h2>
        </div>
        <div class="relationship__copy">
          <p>
            Rangeway brings hospitality, real estate, design, construction, charging, and operating
            experience to the same table.
          </p>
          <p>
            ChargeVia turns that experience into one focused host-site format.
          </p>
          <p class="relationship__tag">ChargeVia by Rangeway.</p>
        </div>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <div class="page-grid faq__grid">
        <header>
          <p class="eyebrow">The useful questions</p>
          <h2 id="faq-title">Yes, there<br />are details<span>.</span></h2>
        </header>
        <div class="faq__list">
          {faqs.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.question}</span>
                <span aria-hidden="true">+</span>
              </summary>
              <p>
                {item.answer}
                {item.email && (
                  <>
                    {" "}<a href={`mailto:${item.email}`}>{item.email}</a>.
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing-cta" aria-labelledby="closing-title">
      <div class="page-grid closing-cta__grid">
        <div>
          <p class="eyebrow eyebrow--on-dark">Have a place worth stopping?</p>
          <h2 id="closing-title">Let’s make it<br />worth charging at<span>.</span></h2>
        </div>
        <div class="closing-cta__action">
          <p>
            Send the property. The amenities. The reason it works.
          </p>
          <a class="button button--orange" href={hostMailto}>
            Show us the site <span aria-hidden="true">»</span>
          </a>
          <a class="closing-cta__email" href="mailto:hello@chargevia.net">
            hello@chargevia.net
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
