---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main id="main" class="home shell">
    <section class="introduction" aria-labelledby="hero-title">
      <figure class="retail-concept">
        <img
          src="/images/cv-retail-1672.webp"
          srcset="/images/cv-retail-640.webp 640w, /images/cv-retail-960.webp 960w, /images/cv-retail-1672.webp 1672w"
          sizes="(min-width: 1500px) 1376px, (min-width: 768px) calc(100vw - 112px), calc(100vw - 56px)"
          alt="Concept rendering of electric vehicles charging beside a retail storefront with outdoor seating"
          width="1672" height="941" fetchpriority="high"
        />
        <figcaption>Concept rendering</figcaption>
      </figure>
      <div class="intro-copy">
        <h1 id="hero-title">Charge where<br />life happens.</h1>
        <div class="intro-copy__aside">
          <p>Fast charging at places<br class="desktop-break" /> worth stopping.</p>
          <a class="idea-link" href="#idea">Meet ChargeVia <span aria-hidden="true">»</span></a>
        </div>
      </div>
    </section>
    <section id="idea" class="idea" aria-labelledby="idea-title">
      <header class="idea__heading">
        <p class="section-label">The idea</p>
        <h2 id="idea-title">A good charging stop<br class="desktop-break" /> starts with a good place.</h2>
      </header>
      <div class="idea__copy">
        <p>ChargeVia by Rangeway is being developed for existing businesses with useful amenities,
          easy access, and people who care about the property.</p>
        <p>A coffee. Lunch. A restroom break. Make the stop useful.</p>
      </div>
    </section>
    <section id="hosts" class="host-story" aria-labelledby="hosts-title">
      <figure class="night-concept">
        <img src="/images/cv-night-1000.webp"
          srcset="/images/cv-night-640.webp 640w, /images/cv-night-1000.webp 1000w"
          sizes="(min-width: 1500px) 600px, (min-width: 768px) 44vw, calc(100vw - 32px)"
          alt="Concept rendering of a charging stop beneath an illuminated canopy at night"
          width="1000" height="558" loading="lazy" decoding="async"
        />
        <figcaption>Concept rendering</figcaption>
      </figure>
      <div class="host-story__copy">
        <p class="section-label">For site hosts</p>
        <h2 id="hosts-title">A place worth stopping?</h2>
        <p class="host-story__description">Rangeway would develop and manage the charging operation.
          You keep running the business your customers know.</p>
        <a class="host-contact" href="mailto:partners@rangeway.co">
          <span>partners@rangeway.co</span><span aria-hidden="true">»</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
