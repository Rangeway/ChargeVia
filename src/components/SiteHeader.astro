---
import Brand from './Brand.astro';
interface Props { current?: 'home' | 'idea' | 'hosts' | 'legal'; }
const { current = 'home' } = Astro.props;
---
<header class="site-header wrap">
  <Brand id="h" size="header" />
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="site-nav__link" href="/the-idea/" aria-current={current === 'idea' ? 'page' : undefined}>The idea</a>
    <a class="site-nav__cta" href="/site-hosts/" aria-current={current === 'hosts' ? 'page' : undefined}>For site hosts</a>
  </nav>
</header>
