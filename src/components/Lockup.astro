---
// Official ChargeVia dark-background lockup (public/lockup-dark.svg), inlined
// so the wordmark renders in the page's Outfit webfont. An <img> reference
// cannot load webfonts and falls back to a system font for the wordmark.
interface Props { id: string; width?: number; }
const { id, width = 196 } = Astro.props;
const height = Math.round((width * 60) / 250);
---
<svg class="lockup" width={width} height={height} viewBox="0 0 250 60" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`og-${id}`} x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FF6B35" />
      <stop offset="100%" stop-color="#E85A24" />
    </linearGradient>
    <linearGradient id={`pg-${id}`} x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#8B6BB4" />
      <stop offset="100%" stop-color="#7B5BA4" />
    </linearGradient>
  </defs>
  <g transform="translate(0, 6) scale(0.6)">
    <rect x="4" y="4" width="72" height="72" rx="16" fill="#111111" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
    <path d="M22 22 L40 40 L22 58" stroke={`url(#og-${id})`} stroke-width="9" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <path d="M40 22 L58 40 L40 58" stroke={`url(#pg-${id})`} stroke-width="9" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  </g>
  <text x="62" y="42" font-family="Outfit, sans-serif" font-weight="700" font-size="38" fill="#FFFFFF">Charge</text>
  <text x="186" y="42" font-family="Outfit, sans-serif" font-weight="700" font-size="38" fill="#FF6B35">Via</text>
</svg>
